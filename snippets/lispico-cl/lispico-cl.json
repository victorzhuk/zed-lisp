{
  "defun": {
    "body": "(defun ${1:name} (${2:x})\n  ${3:body})",
    "description": "Named function definition (Lispico CL)"
  },
  "def": {
    "body": "(def ${1:name} ${2:nil})",
    "description": "Top-level value definition"
  },
  "let": {
    "body": "(let ((${1:x} ${2:nil}))\n  ${3:body})",
    "description": "Local bindings (nested list binding form)"
  },
  "let*": {
    "body": "(let* ((${1:x} ${2:nil})\n        (${3:y} ${4:x}))\n  ${5:body})",
    "description": "Sequential local bindings"
  },
  "setq": {
    "body": "(setq ${1:name} ${2:nil})",
    "description": "Assign an existing binding"
  },
  "loop": {
    "body": "(loop ((${1:i} ${2:0}))\n  (if ${3:done}\n    ${4:result}\n    (recur ${5:next})))",
    "description": "Loop with recur"
  },
  "cond": {
    "body": "(cond\n  (${1:test} ${2:result})\n  (:else ${3:otherwise}))",
    "description": "Parenthesized cond clauses with an :else catch-all"
  },
  "when": {
    "body": "(when ${1:test}\n  ${2:body})",
    "description": "One-armed conditional"
  },
  "try": {
    "body": "(try\n  ${1:body}\n  (catch ${2:error} ${3:handler}))",
    "description": "Try with a catch clause"
  },
  "throw": {
    "body": "(throw ${1:error})",
    "description": "Throw an error value"
  },
  "function-ref": {
    "body": "#'${1:name}",
    "description": "Function reference"
  }
}

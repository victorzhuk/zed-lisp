{
  "defn": {
    "body": "(defn ${1:name} [${2:x}]\n  ${3:body})",
    "description": "Named function definition (Lispico Clojure)"
  },
  "def": {
    "body": "(def ${1:name} ${2:nil})",
    "description": "Top-level value definition"
  },
  "fn": {
    "body": "(fn [${1:x}]\n  ${2:body})",
    "description": "Anonymous function"
  },
  "let": {
    "body": "(let [${1:x} ${2:nil}]\n  ${3:body})",
    "description": "Sequential local bindings (vector binding form)"
  },
  "let*": {
    "body": "(let* [${1:x} ${2:nil}]\n  ${3:body})",
    "description": "Sequential local bindings"
  },
  "loop": {
    "body": "(loop [${1:n} ${2:0}]\n  (if ${3:done}\n    ${4:result}\n    (recur ${5:next})))",
    "description": "Loop with recur"
  },
  "cond": {
    "body": "(cond\n  ${1:test} ${2:result}\n  :else ${3:otherwise})",
    "description": "Flat cond clauses with an :else catch-all"
  },
  "if-let": {
    "body": "(if-let [${1:x} ${2:nil}]\n  ${3:then}\n  ${4:else})",
    "description": "Conditional binding (bootstrap macro)"
  },
  "when-let": {
    "body": "(when-let [${1:x} ${2:nil}]\n  ${3:body})",
    "description": "Conditional binding with implicit else (bootstrap macro)"
  },
  "when": {
    "body": "(when ${1:test}\n  ${2:body})",
    "description": "One-armed conditional"
  },
  "try": {
    "body": "(try\n  ${1:body}\n  (catch ${2:error} ${3:handler}))",
    "description": "Try with a catch clause"
  },
  "throw": {
    "body": "(throw ${1:error})",
    "description": "Throw an error value"
  }
}
